# Server
HOST=0.0.0.0
PORT=1337

# Secrets (Generate using secure random strings or openssl rand -base64 32)
APP_KEYS=generate_random_key_1,generate_random_key_2,generate_random_key_3,generate_random_key_4
API_TOKEN_SALT=generate_random_salt
ADMIN_JWT_SECRET=generate_random_admin_jwt
TRANSFER_TOKEN_SALT=generate_random_transfer_salt
ENCRYPTION_KEY=generate_random_encryption_key
JWT_SECRET=generate_random_jwt_secret

# Database Configuration (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=shop_db
DATABASE_USERNAME=shop_user
DATABASE_PASSWORD=shop_password
DATABASE_SSL=false
